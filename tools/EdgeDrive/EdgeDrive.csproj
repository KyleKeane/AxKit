<Project Sdk="Microsoft.NET.Sdk">
  <!-- Drives a Microsoft Edge window over its DevTools protocol for the Store's website (docs/axKit/store-setup.md
       section 6): a development tool, never part of axKit. No package: HTTP, WebSocket and JSON are the framework's. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The .NET version, Nullable, ImplicitUsings and the resource languages are Directory.Build.props'. -->
    <TargetFramework>$(AxKitDotNet)</TargetFramework>
    <RootNamespace>EdgeDrive</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The bundle's redaction, for what a page's text is printed through. -->
    <ProjectReference Include="..\..\src\AxKit.Core\AxKit.Core.csproj" />
  </ItemGroup>
</Project>
