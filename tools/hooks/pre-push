#!/bin/sh
# Every push of the code repository also syncs the two repositories beside it on the maintainer's computer, the
# reports clone and the private management lists (tools/sync-repos.ps1), so that the lists and the clone go up with
# the code and nobody has to remember to back them up. Installed once per clone with
#     git config core.hooksPath tools/hooks
# (docs/axKit/development-environment.md section 4; release.ps1 refuses to run without it). A sibling's trouble is
# printed and never stops the push: this hook always exits 0. Kept with LF line endings (.gitattributes): sh does not
# read CRLF.
root=$(git rev-parse --show-toplevel)
# git hands a hook GIT_DIR and its kin; the sync must not inherit them, or every git call of its own would act on this
# repository whatever folder it names (the script drops them too).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/tools/sync-repos.ps1" </dev/null
exit 0
