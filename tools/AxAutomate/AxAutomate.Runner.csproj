<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(AxKitDotNet)</TargetFramework>
    <RootNamespace>AxAutomate</RootNamespace>
    <!-- The project is AxAutomate.Runner beside the app axAutomate's src\AxAutomate; the program keeps its name. -->
    <AssemblyName>AxAutomate</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine (docs/axAutomate/SPEC.md AU-5.1): this program is the command line over it. -->
    <ProjectReference Include="..\..\src\AxAutomate.Core\AxAutomate.Core.csproj" />
  </ItemGroup>

</Project>
