<Project Sdk="Microsoft.NET.Sdk">

  <!-- axCalc's window side, as a class library inside AxKit.exe (docs/axKit/SPEC.md AX-1.7): the window, its key table
       and its texts; the pure code is AxCalc.Core. -->
  <PropertyGroup>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AxCalc</RootNamespace>
    <AssemblyName>axCalc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxCalc.Core\AxCalc.Core.csproj" />
    <ProjectReference Include="..\AxKit.Core\AxKit.Core.csproj" />
    <ProjectReference Include="..\AxKit.Forms\AxKit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axCalc\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
