<Project Sdk="Microsoft.NET.Sdk">

  <!-- axFile's window side, as a class library inside AxKit.exe (docs/axKit/SPEC.md AX-1.7): the window, its key table
       and its texts; the pure code is AxFile.Core. -->
  <PropertyGroup>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>axFile</RootNamespace>
    <AssemblyName>axFile</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxFile.Core\AxFile.Core.csproj" />
    <ProjectReference Include="..\AxKit.Core\AxKit.Core.csproj" />
    <ProjectReference Include="..\AxKit.Forms\AxKit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axFile\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
