<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WinForms pieces every app of the bundle uses (docs/axkit/SPEC.md AX-6.2): notices, the question area, the
       sounds, paging in an edit control, the status layout, the bundle-wide keys. No window of its own, no tests
       (checked with NVDA in the apps). -->
  <PropertyGroup>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AxKit.Forms</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxKit.Core\AxKit.Core.csproj" />
  </ItemGroup>

</Project>
