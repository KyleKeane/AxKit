<Project Sdk="Microsoft.NET.Sdk">

  <!-- axClaude's window, as a class library inside AxKit.exe (docs/axKit/SPEC.md AX-1.7, B-2); src/AxKit is the executable. -->
  <PropertyGroup>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>axClaude</RootNamespace>
    <AssemblyName>axClaude</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxClaude.Core\AxClaude.Core.csproj" />
    <ProjectReference Include="..\AxKit.Core\AxKit.Core.csproj" />
    <ProjectReference Include="..\AxKit.Forms\AxKit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file; publish.ps1 ships it next to the executable as README.md. -->
    <EmbeddedResource Include="..\..\docs\axClaude\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
