<Project Sdk="Microsoft.NET.Sdk">

  <!-- axPreview's app side, as a class library inside AxKit.exe (docs/axkit/SPEC.md AX-1.7): what axPreview is, as
       data for the text editor shell in AxKit.Forms (read-only), its key table and its texts; the pure code is
       AxPreview.Core. -->
  <PropertyGroup>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>axPreview</RootNamespace>
    <AssemblyName>axPreview</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxPreview.Core\AxPreview.Core.csproj" />
    <ProjectReference Include="..\AxKit.Core\AxKit.Core.csproj" />
    <ProjectReference Include="..\AxKit.Forms\AxKit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axpreview\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
