<Project Sdk="Microsoft.NET.Sdk">

  <!-- axStart's window side, as a class library inside AxKit.exe (docs/axKit/SPEC.md AX-1.7): the window, the shell's
       Applications folder, the sign-in start, its key table and its texts; the pure code is AxStart.Core. -->
  <PropertyGroup>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>axStart</RootNamespace>
    <AssemblyName>axStart</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxStart.Core\AxStart.Core.csproj" />
    <ProjectReference Include="..\AxKit.Core\AxKit.Core.csproj" />
    <ProjectReference Include="..\AxKit.Forms\AxKit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axStart\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
