<Project Sdk="Microsoft.NET.Sdk">

  <!-- axTerminal's window, as a class library inside AxKit.exe (docs/axkit/SPEC.md AX-1.7, B-2); src/AxKit is the executable. -->
  <PropertyGroup>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>axTerminal</RootNamespace>
    <AssemblyName>axTerminal</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxTerminal.Core\AxTerminal.Core.csproj" />
    <ProjectReference Include="..\AxKit.Core\AxKit.Core.csproj" />
    <ProjectReference Include="..\AxKit.Forms\AxKit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axterminal\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
