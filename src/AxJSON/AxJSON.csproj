<Project Sdk="Microsoft.NET.Sdk">

  <!-- axJSON's window side, as a class library inside AxKit.exe (docs/axkit/SPEC.md AX-1.7): the app as data for the
       editor shell, its key table and its texts; the pure code is AxJSON.Core. -->
  <PropertyGroup>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>axJSON</RootNamespace>
    <AssemblyName>axJSON</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxJSON.Core\AxJSON.Core.csproj" />
    <ProjectReference Include="..\AxKit.Core\AxKit.Core.csproj" />
    <ProjectReference Include="..\AxKit.Forms\AxKit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axjson\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
