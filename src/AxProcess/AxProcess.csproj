<Project Sdk="Microsoft.NET.Sdk">

  <!-- axProcess's window side, as a class library inside AxKit.exe (docs/axkit/SPEC.md AX-1.7): the window, its key
       table and its texts; the pure code is AxProcess.Core. -->
  <PropertyGroup>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AxProcess</RootNamespace>
    <AssemblyName>axProcess</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxProcess.Core\AxProcess.Core.csproj" />
    <ProjectReference Include="..\AxKit.Core\AxKit.Core.csproj" />
    <ProjectReference Include="..\AxKit.Forms\AxKit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axprocess\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
