<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(AxKitDotNet)</TargetFramework>
    <RootNamespace>AxKit.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The AxKit menu's About, AxKit guide shows this file (AX-9.9); publish.ps1 ships it in the zip as README.md. -->
    <EmbeddedResource Include="../../docs/axKit/README.md" LogicalName="AxKitGuide.md" />
    <EmbeddedResource Include="../../NOTICE.md" LogicalName="Notice.md" />
    <EmbeddedResource Include="../../PRIVACY.md" LogicalName="Privacy.md" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.md" LogicalName="ThirdPartyNotices.md" />
    <!-- The reporter account's token for the reports (docs/axKit/reports.md RP-6.2): written by publish.ps1 from the
         release secret through tools/reporter-token.ps1, ignored by git, embedded only when it is there. -->
    <EmbeddedResource Include="Reports/reporter.token" LogicalName="AxKit.Core.ReporterToken" Condition="Exists('Reports/reporter.token')" />
  </ItemGroup>

</Project>
