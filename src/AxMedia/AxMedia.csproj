<Project Sdk="Microsoft.NET.Sdk">

  <!-- axMedia's window side, as a class library inside AxKit.exe (docs/axkit/SPEC.md AX-1.7): the window, its key table
       and its texts; the pure code is AxMedia.Core. -->
  <PropertyGroup>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>axMedia</RootNamespace>
    <AssemblyName>axMedia</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxMedia.Core\AxMedia.Core.csproj" />
    <ProjectReference Include="..\AxKit.Core\AxKit.Core.csproj" />
    <ProjectReference Include="..\AxKit.Forms\AxKit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axmedia\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
