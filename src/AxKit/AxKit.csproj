<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AxKit</RootNamespace>
    <AssemblyName>AxKit</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>AxClaude.ico</ApplicationIcon>
    <Version>5.9.1</Version>
    <Product>axKit</Product>
    <Description>Accessible Windows apps for screen reader users: axClaude, a front end for the Claude Code CLI, axDown, a text editor, axJSON, a JSON editor, axGIT, a git manager, axTerminal, a terminal, axFile, a file manager, axMedia, a player, axPreview, a viewer, axStart, a program launcher, axProcess, a view of the processes, services and startup programs, axTask, tasks and lists, axPass, a KeePass password database, axCalc, a calculator, axClip, a clipboard history, axMCP, access layer for MCP servers: the tools, resources and prompts of any MCP server on this computer, run by hand, axHelp, access layer for Claude Code: your conversation with Claude and a screenshot into it, from anywhere, axAutomate, workflows that drive the windows of axKit</Description>
    <Authors>Dr. Kyle Keane</Authors>
    <Company>Dr. Kyle Keane, www.kylekeane.com</Company>
    <Copyright>Copyright (c) 2026 Dr. Kyle Keane (www.kylekeane.com). AGPL-3.0-only, with the terms in NOTICE.md.</Copyright>
  </PropertyGroup>

  <!-- One .ico per app next to this file (AxDown.ico to AxClip.ico; tools/make-icon.ps1 draws them) are the apps'
       icons for their Start menu and File Explorer entries (the executable's own icon is axClaude's). publish.ps1
       copies every one of them next to the executable, since a single-file publish would bundle a project item
       into the executable, and install.ps1 copies them on. -->

  <!-- The build guard: a build over an axKit that runs from the output folder stops here, in one plain line, before
       anything is compiled or copied. Windows lets nobody write an executable that is running, so the build would
       fail late, on the first file in use, after replacing some of the folder's files and leaving the rest: a folder
       half of one build and half of another (the reason for "never build into the running app's bin", a note of the
       root CLAUDE.md until 2026-11-16). The executable is opened for appending and nothing is written: it opens when
       nothing runs from the folder, and is refused when something does. Only where the executable is already there;
       a build into a scratch folder (-o) asks about that folder's copy. -->
  <Target Name="StopOverRunningAxKit" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT' And Exists('$(TargetDir)$(AssemblyName).exe')">
    <Exec Command="(type nul &gt;&gt; &quot;$(TargetDir)$(AssemblyName).exe&quot;) 2&gt;nul || exit 1" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="AxKitExeOpened" />
    </Exec>
    <Error Condition="'$(AxKitExeOpened)' != '0'" Text="axKit is running from this folder: close it or build with -o &lt;scratch folder&gt; ($(TargetDir)$(AssemblyName).exe cannot be written)" />
  </Target>

  <!-- Every project of src: the apps' windows and their Cores, and the shared projects (docs/axKit/app-kit.md AK-4.1),
       so that a new app's projects are referenced by being there. -->
  <ItemGroup>
    <ProjectReference Include="..\*\*.csproj" Exclude="..\AxKit\AxKit.csproj" />
  </ItemGroup>

</Project>
