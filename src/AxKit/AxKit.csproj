<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(AxKitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AxKit</RootNamespace>
    <AssemblyName>AxKit</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>AxClaude.ico</ApplicationIcon>
    <Version>5.4.0</Version>
    <Product>axKit</Product>
    <Description>Accessible Windows apps for screen reader users: axClaude, a front end for the Claude Code CLI, axDown, a text editor, axJSON, a JSON editor, axGIT, a git manager, axTerminal, a terminal, axFile, a file manager, axMedia, a player, axPreview, a viewer, axStart, a program launcher, axProcess, a view of the processes, services and startup programs, axTask, tasks and lists, axPass, a KeePass password database, axCalc, a calculator, axClip, a clipboard history, axMCP, access layer for MCP servers: access layer for MCP servers: the tools, resources and prompts of any MCP server on this computer, run by hand, axHelp, access layer for Claude Code: a question from anywhere or about this window, answered by Claude, and axDescribe, access layer for Claude Code: the window in front described by Claude</Description>
    <Authors>Dr. Kyle Keane</Authors>
    <Company>Dr. Kyle Keane, www.kylekeane.com</Company>
    <Copyright>Copyright (c) 2026 Dr. Kyle Keane (www.kylekeane.com). AGPL-3.0-only, with the terms in NOTICE.md.</Copyright>
  </PropertyGroup>

  <!-- One .ico per app next to this file (AxDown.ico to AxClip.ico; tools/make-icon.ps1 draws them) are the apps'
       icons for their Start menu and File Explorer entries (the executable's own icon is axClaude's). publish.ps1
       copies every one of them next to the executable, since a single-file publish would bundle a project item
       into the executable, and install.ps1 copies them on. -->

  <!-- Every project of src: the apps' windows and their Cores, and the shared projects (docs/axkit/app-kit.md AK-4.1),
       so that a new app's projects are referenced by being there. -->
  <ItemGroup>
    <ProjectReference Include="..\*\*.csproj" Exclude="..\AxKit\AxKit.csproj" />
  </ItemGroup>

</Project>
